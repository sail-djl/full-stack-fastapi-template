\"f2\\\",\\r\\n        \\\"command\\\": \\\"-editor.action.rename\\\",\\r\\n        \\\"when\\\": \\\"editorHasRenameProvider && editorTextFocus && !editorReadonly\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+oem_2\\\",\\r\\n        \\\"command\\\": \\\"editor.action.blockComment\\\",\\r\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"shift+alt+a\\\",\\r\\n        \\\"command\\\": \\\"-editor.action.blockComment\\\",\\r\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+d\\\",\\r\\n        \\\"command\\\": \\\"workbench.action.unpinEditor\\\",\\r\\n        \\\"when\\\": \\\"activeEditorIsPinned\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+k shift+enter\\\",\\r\\n        \\\"command\\\": \\\"-workbench.action.unpinEditor\\\",\\r\\n        \\\"when\\\": \\\"activeEditorIsPinned\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"alt+q\\\",\\r\\n        \\\"command\\\": \\\"outline.focus\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+b\\\",\\r\\n        \\\"command\\\": \\\"editor.action.revealDefinition\\\",\\r\\n        \\\"when\\\": \\\"editorHasDefinitionProvider && editorTextFocus && isWeb\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+shift+c\\\",\\r\\n        \\\"command\\\": \\\"-workbench.action.terminal.copySelection\\\",\\r\\n        \\\"when\\\": \\\"terminalTextSelectedInFocused || terminalFocus && terminalHasBeenCreated && terminalTextSelected || terminalFocus && terminalProcessSupported && terminalTextSelected || terminalFocus && terminalTextSelected && terminalTextSelectedInFocused || terminalHasBeenCreated && terminalTextSelected && terminalTextSelectedInFocused || terminalProcessSupported && terminalTextSelected && terminalTextSelectedInFocused\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+r\\\",\\r\\n        \\\"command\\\": \\\"editor.action.startFindReplaceAction\\\",\\r\\n        \\\"when\\\": \\\"editorFocus || editorIsOpen\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+r\\\",\\r\\n        \\\"command\\\": \\\"editor.action.startFindReplaceAction\\\",\\r\\n        \\\"when\\\": \\\"editorFocus || editorIsOpen\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+r\\\",\\r\\n        \\\"command\\\": \\\"editor.action.startFindReplaceAction\\\",\\r\\n        \\\"when\\\": \\\"editorFocus || editorIsOpen\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+b\\\",\\r\\n        \\\"command\\\": \\\"editor.action.revealDefinition\\\",\\r\\n        \\\"when\\\": \\\"editorHasDefinitionProvider && editorTextFocus\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"f12\\\",\\r\\n        \\\"command\\\": \\\"-editor.action.revealDefinition\\\",\\r\\n        \\\"when\\\": \\\"editorHasDefinitionProvider && editorTextFocus\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+alt+d\\\",\\r\\n        \\\"command\\\": \\\"-extension.ts.deporter.ts\\\",\\r\\n        \\\"when\\\": \\\"resourceLangId == 'typescript'\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+alt+d\\\",\\r\\n        \\\"command\\\": \\\"-extension.ts.deporter.js\\\",\\r\\n        \\\"when\\\": \\\"resourceLangId == 'javascript'\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+alt+d\\\",\\r\\n        \\\"command\\\": \\\"workbench.action.openGlobalKeybindings\\\"\\r\\n    },\\r\\n    {\\r\\n        \\\"key\\\": \\\"ctrl+w\\\",\\r\\n        \\\"command\\\": \\\"editor.action.smartSelect.expand\\\",\\r\\n        \\\"when\\\": \\\"editorTextFocus\\\"\\r\\n    }\\r\\n]\",\"platform\":3}","snippets":"{\"snippets\":{\"cl.code-snippets\":\"{\\n\\t// Place your 全局 snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and \\n\\t// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope \\n\\t// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is \\n\\t// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: \\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. \\n\\t// Placeholders with the same ids are connected.\\n\\t// Example:\\n\\t\\\"日志输出到控制台\\\": {\\n\\t\\t\\\"prefix\\\": \\\"log\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"console.log('$1');\\\",\\n\\t\\t\\t\\\"$2\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"日志输出到控制台\\\"\\n\\t},\\n\\t\\\"debug\\\": {\\n\\t\\t\\\"prefix\\\": \\\"deb\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"debugger\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"debug操作\\\"\\n\\t},\\n\\t\\\"注释\\\": {\\n\\t\\t\\\"prefix\\\": \\\"zs\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\" <!-- $end -->\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"添加注释\\\"\\n\\t},\\n\\t\\\"异步函数-最后\\\": {\\n\\t\\t\\\"prefix\\\": \\\"fin\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"finally(()=>{$1})\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"异步函数-最后\\\"\\n\\t},\\n\\t\\\"API-新建\\\": {\\n\\t\\t\\\"prefix\\\": \\\"api\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"export const $1 = () => {return request({url: '$2',method: '$3',params: {$4}})\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"API-新建\\\"\\n\\t},\\n\\t\\\"列定义\\\": {\\n\\t\\t\\\"prefix\\\": \\\"col\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"{\\\",\\n\\t\\t\\t\\\"    label: '$1',\\\",\\n\\t\\t\\t\\\"    prop: '$2',\\\",\\n\\t\\t\\t\\\"    type: select,\\\",\\n\\t\\t\\t\\\"    order: 1,\\\",\\n\\t\\t\\t\\\"    hide: false,\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"列定义\\\"\\n\\t},\\n\\t\\\"模板\\\": {\\n\\t\\t\\\"prefix\\\": \\\"\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"\\\"\\n\\t},\\n\\n\\t\\n}\",\"sql.json\":\"{\\n\\t// Place your snippets for sql here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"acr0most.ts-deporter\",\"uuid\":\"d32ff0bd-82a5-4417-8995-b4528503b706\"},\"displayName\":\"Typescript/Javascript Deporter\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"adamraichu.zip-viewer\",\"uuid\":\"51bca40f-a124-4202-9612-cb459f8c9690\"},\"displayName\":\"Zip Tools\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ahmadalli.vscode-nginx-conf\",\"uuid\":\"9a97436d-76aa-479c-8ae9-db2f400a7b04\"},\"displayName\":\"NGINX Configuration Language Support\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"arcanis.vscode-zipfs\",\"uuid\":\"b14d47f6-5230-4a65-9366-82edc70d5dfd\"},\"displayName\":\"ZipFS - a zip file system\",\"disabled\":true,\"applicationScoped\":false},{\"identifier\":{\"id\":\"christian-kohler.path-intellisense\",\"uuid\":\"a41c1549-4053-44d4-bf30-60fc809b4a86\"},\"displayName\":\"Path Intellisense\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"cweijan.vscode-office\",\"uuid\":\"936b1be7-8595-4f76-b102-aa6bb915da73\"},\"displayName\":\"Office Viewer\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"cweijan.vscode-typora\",\"uuid\":\"7577cc52-937b-4a1d-b749-b2fbc8399d98\"},\"displayName\":\"Typora\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"eliean.vscode-svn\",\"uuid\":\"961848f5-0cb4-48db-9c9f-5ffa5375af92\"},\"dis