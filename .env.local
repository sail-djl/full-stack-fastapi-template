# ============================================
# 本地开发环境配置
# ============================================

ENVIRONMENT=local

# PostgreSQL 数据库配置（本地）
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=app

# 前端配置
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=[]

# 超级用户配置
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# 邮件配置（本地开发通常不需要）
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=
